        <TextBox x:Name="RRR" HorizontalAlignment="Left" Margin="124,77,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="30" MaxLength="3" PreviewKeyDown="TB_PreviewKeyDown" TabIndex="4" FontSize="16" IsEnabled="False" Grid.Column="1"/>
        <Label Content="L-Bra" HorizontalAlignment="Left" Margin="157,73,0,0" VerticalAlignment="Top" FontSize="16" IsEnabled="False" Grid.Column="1"/>
