        <Button x:Name="BT_Clear" Content="清除" HorizontalAlignment="Left" Margin="21,339,0,0" VerticalAlignment="Top" Click="BT_Clear_Click" IsTabStop="False" FontSize="16" Width="100" Height="32" Grid.ColumnSpan="2"/>
        <Button x:Name="BTN_TOP" Content="最上層" HorizontalAlignment="Left" Margin="72,339,0,0" VerticalAlignment="Top" IsTabStop="False" Click="BTN_TOP_Click" FontSize="16" Width="100" Height="32" Grid.Column="1"/>
        <Button x:Name="BTN_OCR" Content="OCR" HorizontalAlignment="Left" Margin="72,413,0,0" VerticalAlignment="Top" IsTabStop="False" FontSize="16" Width="100" Click="BTN_OCR_Click" IsEnabled="False" Grid.Column="1"/>
        <Button x:Name="BTN_OCR_Copy" Content="載入資料" HorizontalAlignment="Left" Margin="21,413,0,0" VerticalAlignment="Top" IsTabStop="False" FontSize="16" Width="100" Click="BTN_ALL_Click" Grid.ColumnSpan="2"/>
